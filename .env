# -------------------------------------------------------------
# .env file — stores secret values and configuration settings
# -------------------------------------------------------------

# MongoDB settings
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=simpledrive

# MinIO storage settings
MINIO_ENDPOINT=minio:9000
# The browser uses localhost because it runs outside Docker containers.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ROOT_USER=simpledrive_admin
MINIO_ROOT_PASSWORD=simpledrive_password123
MINIO_BUCKET_NAME=simpledrive-files
